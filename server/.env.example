PORT=3005
HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=internshala
PYTHON_BIN=/var/www/intershala/.venv/bin/python

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

